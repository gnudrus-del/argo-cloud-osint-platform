cff-version: 1.2.0
message: >-
  If Argo Cloud OSINT Platform contributes to your published work,
  professional report, or investigation, please cite it using the
  metadata below. This metadata is machine-readable (Citation File
  Format v1.2) and may be exported from GitHub as APA or BibTeX from
  the "Cite this repository" widget on the repository home page.
title: "Argo Cloud OSINT Platform"
type: software
abstract: >-
  Self-hosted, privacy-by-design open-source-intelligence platform
  providing a command-line interface, a web user interface, a plugin
  architecture with fifty-eight native connectors (forty-three
  key-free and fifteen bring-your-own-key), a SHA-256 tamper-evident
  audit chain, GDPR data-subject rights endpoints, and reproducible
  exports in Markdown, JSON, PDF, STIX 2.1 and MISP core-format 2.4.
  Designed for authorised, defensive investigations under a
  privacy-by-design and audit-first operating model.
authors:
  - name: "Argo Cloud OSINT Platform contributors"
    website: "https://github.com/gnudrus-del/argo-cloud-osint-platform"
repository-code: "https://github.com/gnudrus-del/argo-cloud-osint-platform"
url: "https://github.com/gnudrus-del/argo-cloud-osint-platform"
license: Apache-2.0
version: "0.2.0"
date-released: "2026-07-14"
keywords:
  - "open source intelligence"
  - "defensive OSINT"
  - "threat intelligence"
  - "digital investigations"
  - "self-hosted"
  - "STIX 2.1"
  - "MISP"
  - "audit chain"
  - "privacy by design"
  - "GDPR"
  - "computer forensics"
  - "authorised investigation"
identifiers:
  - type: url
    value: "https://github.com/gnudrus-del/argo-cloud-osint-platform/releases/tag/v0.1.0"
    description: "First public release (v0.1.0)"
