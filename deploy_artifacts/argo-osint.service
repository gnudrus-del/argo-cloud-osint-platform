[Unit]
Description=Argo bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/argo-osint
EnvironmentFile=/opt/argo-osint/.env
ExecStart=/opt/argo-osint/.venv/bin/python -m osint_bot.web --port 7655 --host 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/argo-osint/web_jobs /opt/argo-osint/audit
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
