# =============================================================================
# Argo OSINT — ESEMPIO .env
# =============================================================================
# Copia in .env e configura le variabili di cui hai bisogno.
# NON committare mai il .env (già in .gitignore). Su una VM: chmod 600.
# Tutte le var sono facoltative: mancando, il connettore relativo va in
# `missing_key` in modo pulito. La piattaforma base funziona anche a zero env.
# =============================================================================

# ─── Web server ─────────────────────────────────────────────────────────────
OSINT_WEB_HOST=127.0.0.1
OSINT_WEB_PORT=7655
OSINT_WEB_TOKEN=                # bearer opzionale per health checks (non auth utenti)
OSINT_JOB_DIR=web_jobs
OSINT_SIGNUPS_ENABLED=1
OSINT_SECURE_COOKIE=1           # 1 in produzione (dietro HTTPS)
OSINT_HSTS=1                    # 1 in produzione
OSINT_MAX_JSON_BYTES=65536
OSINT_MAX_UPLOAD_BYTES=26214400

# ─── Amministrazione (sblocco tool nascosti) ────────────────────────────────
# GENERAZIONE HASH:
#   python -c "import os,hashlib,binascii;s=os.urandom(16);h=hashlib.pbkdf2_hmac('sha256',b'la_tua_password',s,200000);print(f'pbkdf2_sha256$200000${s.hex()}${h.hex()}')"
ARGO_ADMIN_USER=
ARGO_ADMIN_PASSWORD_HASH=

# ─── Storage (default SQLite a zero configurazione; Postgres raccomandato ───
# in produzione/multi-analista — vedi docker-compose.yml e docs/CONFIGURATION.md)
# DATABASE_URL=postgresql://argo:password@127.0.0.1:5433/argo
# OSINT_STORAGE_STRICT=0          # 1 = Postgres irraggiungibile e' un errore fatale, non un fallback silenzioso su SQLite

# ─── Coda (opzionale: default in-process) ───────────────────────────────────
# QUEUE_BACKEND=celery
# CELERY_BROKER_URL=redis://127.0.0.1:6380/0

# ─── Grafo/Ricerca (opzionali) ──────────────────────────────────────────────
# NEO4J_HTTP_URL=http://127.0.0.1:7475
# NEO4J_PASSWORD=
# OPENSEARCH_URL=http://127.0.0.1:9200

# ─── Cifratura API key BYOK a riposo (envelope encryption, sempre attiva) ───
# La master key che protegge le API key salvate nel DB vive fuori dal DB per
# costruzione — mai una riga di tabella. Nessuna delle due variabili sotto è
# obbligatoria: senza nessuna delle due, Argo autogenera e persiste una
# master key locale (<OSINT_JOB_DIR>/.master_key, chmod 600) al primo uso.
# OSINT_MASTER_KEY=            # base64, 32 byte — se un secret manager la inietta come env var
# OSINT_MASTER_KEY_FILE=       # path a un file con la chiave in base64 — pensato per
                                # systemd LoadCredential=: ${CREDENTIALS_DIRECTORY}/argo_master_key
# Rotazione: `argo-rotate-master-key --yes` (richiede riavvio del servizio dopo).

# ─── API key BYOK (le stesse configurabili dal tab "Chiavi API") ────────────
BING_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
GOOGLE_PSE_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
HIBP_API_KEY=
HUNTER_API_KEY=
INTELX_API_KEY=
EPIEOS_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GITHUB_TOKEN=
LEAKIX_API_KEY=
FULLHUNT_API_KEY=
SECURITYTRAILS_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
ETHERSCAN_API_KEY=
COMPANIES_HOUSE_API_KEY=
INFLUENCERS_CLUB_API_KEY=

# ─── Tool locali installati (path eseguibili — nessuna credenziale qui) ─────
MAIGRET_PYTHON=/opt/argo-maigret/.venv/bin/python
MAIGRET_HOME=/opt/argo-osint/web_jobs/.maigret-home
MAIGRET_TIMEOUT_S=300

HOLEHE_CMD=/opt/argo-holehe/.venv/bin/holehe
HOLEHE_TIMEOUT_S=120

IGNORANT_CMD=/opt/argo-ignorant/.venv/bin/ignorant
IGNORANT_TIMEOUT_S=90

THEHARVESTER_CMD=/opt/argo-theharvester/.venv/bin/theHarvester
THEHARVESTER_TIMEOUT_S=180

GHUNT_CMD=/opt/argo-ghunt/.venv/bin/ghunt
GHUNT_HOME=/opt/argo-osint/web_jobs/.ghunt-home   # completa `ghunt login` per attivare
GHUNT_TIMEOUT_S=60

# TOUTATIS_CMD + TOUTATIS_SESSION (sessionid Instagram DELL'INVESTIGATORE)
TOUTATIS_CMD=/opt/argo-toutatis/.venv/bin/toutatis
TOUTATIS_SESSION=
TOUTATIS_TIMEOUT_S=60

# TELEGRAM (api_id/hash da https://my.telegram.org/apps + numero investigatore)
TELEGRAM_CMD=/opt/argo-telegram/.venv/bin/telegram-phone-number-checker
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_TIMEOUT_S=90

# LinkedIn2Username (username/password LinkedIn DELL'INVESTIGATORE)
LINKEDIN2U_PYTHON=/opt/argo-linkedin/.venv/bin/python
LINKEDIN2U_SCRIPT=/opt/argo-linkedin/repo/linkedin2username.py
LINKEDIN_USER=
LINKEDIN_PASS=
LINKEDIN2U_TIMEOUT_S=240

# MISP (opzionale, se hai un'istanza MISP)
MISP_URL=
MISP_KEY=
MISP_VERIFY=1

# FlowSINT (opzionale, se attivo lo stack Docker FlowSINT)
FLOWSINT_URL=
FLOWSINT_USER=
FLOWSINT_PASSWORD=
FLOWSINT_PUBLIC_URL=

# ─── Agente IA (LLM, opt-in — vedi docs/CONFIGURATION.md e docs/THREAT_MODEL.md) ─
# Disattivato di default. Anche ad OSINT_AI_AGENTS_ENABLED=1, nessuna chiamata
# parte finché il titolare del caso non abilita l'IA per QUEL caso e l'analista
# non configura una chiave BYOK (qui sotto o dal tab "Chiavi API").
# OSINT_AI_AGENTS_ENABLED=0
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LOCAL_LLM_BASE_URL=          # endpoint OpenAI-compatible (Ollama/llama.cpp), es. http://127.0.0.1:11434/v1|bearer_token
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# LOCAL_LLM_MODEL=             # nessun default sicuro: obbligatorio per provider=local

# ─── Sigillo report (Ed25519 sempre attivo + RFC3161 opt-in) ────────────────
# La firma Ed25519 di ogni report completato NON richiede configurazione (si
# auto-genera al primo uso) — le variabili qui sotto sono entrambe opzionali.
# OSINT_REPORT_SIGNING_KEY_PATH=   # default: <OSINT_JOB_DIR>/.report_signing_key — fai backup, chmod 600
# TSA_URL=                         # vuoto = timestamp RFC3161 disattivato (404).
                                    # Esempi noti (verifica i termini d'uso prima
                                    # di un uso in produzione): http://timestamp.digicert.com,
                                    # https://freetsa.org/tsr, http://timestamp.sectigo.com

# ─── Verifica email al signup (opzionale — vedi osint_bot/email_verification.py) ─
# Senza configurazione: provider "console", il link di verifica finisce in
# web_jobs/email_log.jsonl invece di essere spedito — comodo in sviluppo,
# da NON lasciare così in produzione.
# EMAIL_VERIFICATION_SECRET=   # HMAC del token; se assente Argo ne genera uno
                                # dev-only e stampa un warning — impostalo esplicitamente in produzione
# EMAIL_PROVIDER=console       # resend | smtp | console
# EMAIL_FROM_ADDR=argo@localhost
# EMAIL_FROM_NAME=Argo
# EMAIL_VERIFICATION_BASE_URL=http://127.0.0.1:7655   # dominio pubblico in produzione
# EMAIL_TOKEN_TTL_SECONDS=86400
#
# Provider "resend" (consigliato):
# RESEND_API_KEY=re_xxxxxxxxxxxx
#
# Provider "smtp" (Gmail, Mailgun, lo stesso Resend via SMTP, ...):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ─── Rete / varie ────────────────────────────────────────────────────────────
# ARGO_CONTACT_URL=          # email o URL messo nello User-Agent per servizi
                              # pubblici che lo richiedono (Nominatim, SEC EDGAR).
                              # Default generico privo di PII se non impostato.
# OSINT_SESSION_TTL_SECONDS=28800
# OSINT_HTTP_PROXY=          # proxy per _safe_http (outbound sanzionato); OSINT_HTTPS_PROXY per lo schema https
